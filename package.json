{
  "name": "com.qiongge.toolbox",
  "version": "1.0.0",
  "description": "穷哥们的工具箱（Electron + Vue 本地应用）",
  "main": "./out/main/index.js",
  "author": "穷哥们的工具箱",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "setup:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-python.ps1",
    "setup:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-backend-deps.ps1",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-app.ps1",
    "app:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-app.ps1 -DebugPort 9355",
    "smoke": "node scripts/smoke-test.mjs 9355 .tmp/screenshots"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "three": "^0.187.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  }
}
